        "components" : [ {
          "componentAttributes" : {
            "richTextValue" : "<p style=\"text-align: justify;\"><strong style=\"font-size: 24px;\">PROFESSIONAL :</strong></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\">I’<span style=\"font-size: 16px;\">m someone who thrives on learning and curiosity, whether it's diving into a new technology or solving complex problems. Outside of work, I love exploring how things work and finding creative ways to make life more efficient. I’m passionate about tech not just as a career, but as a way to bring positive change to everyday processes. I enjoy challenges, and when I’m not troubleshooting issues, you can find me researching new trends or experimenting with digital tools that enhance productivity and creativity.</span></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: