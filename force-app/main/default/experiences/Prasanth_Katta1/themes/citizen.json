  "customCSS" : "/* Center the whole form and boxes to the center of the page */\n.np-form {\n  font-weight: bold;\n  font-family: Nunito;\n  border-radius: 5px;\n  background-color: rgb(\n    45,\n    53,\n    57\n  ); /*rgb(156, 215, 229); /* Background color */\n  padding: 24px;\n  width: 100%; /* Adjust width as needed to fit the section better */\n  max-width: 800px; /* Maximum width to prevent it from becoming too wide */\n  margin: auto; /* Center the form horizontally */\n  font-size: 16px; /* Increase font size */\n  border: 1px solid black; /* Black border */\n  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1); /* Optional: adds a shadow for better visibility */\n}\n\n.np-form input,\n.np-form textarea,\n.np-form select {\n  font-weight: normal !important;\n}\n\n.np-form::after {\n  content: \"\";\n  display: table;\n  clear: both;\n}\n\n.np-form .col-25,\n.np-form .col-75 {\n  float: left;\n  width: 50%;\n  margin-top: 10px;\n  color: white;\n}\n\n/* Placeholder text color */\n.np-form input::placeholder,\n.np-form textarea::placeholder {\n  color: rgba(255, 255, 255, 0.7); /* White color with some opacity */\n}\n\n.slds-tabs_default,\n.slds-tabset__content {\n  background-color: rgb(233, 237, 238) !important;\n  font-size: 20px !important;\n}\n\n/* Hide the search bar */\n.themeUtilsContainer .themeSearch {\n  display: none !important;\n}\n\n/* Hide the profile menu */\n.themeUtilsContainer .themeProfileMenu {\n  display: none !important;\n}\n\n.comm-navigation__top-level-item-link {\n  font-size: 15.5px; /* Adjust the size as needed */\n  color: #ffffff; /* Optional: change text color */\n  font-weight: 700;\n}\n\n/* Style for contentCaption */\n.contentCaption {\n  color: #ffffff; /* Ensure text color is white */\n  font-size: 65px !important; /* Increase font size with !important */\n  font-weight: 500; /* Make it bold */\n  text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.7); /* Apply text shadow */\n  font-family: \"Brush Script MT\", cursive;\n}\n\n/* Style for contentTitle */\n.contentTitle {\n  color: #ffffff; /* Ensure text color is white */\n  font-size: 80px !important; /* Increase font size with !important */\n  font-weight: 500; /* Make it bold */\n  text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.7); /* Apply text shadow */\n  font-family: \"Brush Script MT\", cursive;\n}\n\n.contentSubtitle {\n  color: #d3d3d3 !important; /* Ensure text color is white */\n  font-size: 30px !important; /* Increase font size with !important */\n  font-weight: 300; /* Make it bold */\n  text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.7); /* Apply text shadow */\n  font-family: \"Brush Script MT\", cursive;\n}\n\n.slds-tabs_default__nav .slds-tabs_default__link {\n  font-size: 16px !important; /* Increased font size */\n  font-weight: bold !important; /* Set to bold */\n}\n\n.comm-tile-menu__item-title {\n  font-weight: 600;\n  font-size: 18px !important;\n}\n\n/* Responsive layout - when the screen is less than 1062px wide, make the two columns stack on top of each other instead of next to each other */\n@media screen and (max-width: 1062px) {\n  .np-form .col-25,\n  .np-form .col-75,\n  .np-form input[type=\"submit\"] {\n    width: 100%;\n    margin-top: 0;\n  }\n\n  .np-form button[type=\"submit\"] {\n    background-color: #4caf50; /* Green background color */\n    color: white; /* White text color */\n    padding: 12px 20px; /* Padding for the button */\n    border: none; /* Remove default border */\n    border-radius: 5px; /* Rounded corners */\n    cursor: pointer; /* Pointer cursor on hover */\n    font-size: 16px; /* Font size */\n    text-align: center; /* Center text */\n    display: block; /* Block display */\n    margin: 20px auto; /* Center button horizontally with margin */\n    transition: background-color 0.3s ease; /* Smooth transition for background color */\n  }\n\n  .np-form select {\n    width: 100%;\n  }\n}\n\n@media screen and (max-width: 1062px) {\n  .contentCaption {\n    font-size: 35px !important; /* Smaller font size for mobile */\n    font-family: \"Brush Script MT\", cursive;\n    font-weight: 700;\n    margin-top: 45px !important; /* Adjust margin to move down the title */\n  }\n\n  .contentTitle {\n    font-size: 40px !important; /* Smaller font size for mobile */\n    font-family: \"Brush Script MT\", cursive;\n    font-weight: 700;\n  }\n\n  .contentSubtitle {\n    font-size: 20px !important; /* Smaller font size for mobile */\n    font-family: \"Brush Script MT\", cursive;\n    font-weight: 500;\n  }\n}\n\n/* Target the tile menu items */\n\n.comm-tile-menu__container {\n    display: flex;\n    justify-content: space-between; /* Spread tiles evenly */\n    flex-wrap: wrap; /* Allow wrapping to the next line if needed */\n    padding: 10px; /* Add padding if needed */\n    box-sizing: border-box; /* Include padding and border in element's total width and height */\n}\n\n.comm-tile-menu__item {\n    width: 235px; /* Adjust width as needed */\n    height: 215px; /* Adjust height as needed */\n    overflow: hidden; /* Ensure no overflow */\n    padding: 5px; /* Adjust padding as needed */\n    margin: 5px; /* Adjust margin as needed */\n}\n\n/* Adjust the inner content for better presentation */\n.comm-tile-menu__item .comm-tile-menu__item-tile {\n    height: 50px; /* Adjust inner tile height */\n}\n\n.comm-tile-menu__item .comm-tile-menu__icon-section img {\n    max-height: 40px; /* Adjust icon size */\n    max-width: 40px; /* Adjust icon size */\n}\n\n.comm-tile-menu__item .comm-tile-menu__item-title {\n    font-size: 14px; /* Adjust title font size */\n    margin-top: 5px; /* Adjust margin to align the title better */\n    white-space: normal; /* Allow text to wrap */\n    overflow: hidden; /* Hide overflow */\n    text-overflow: ellipsis; /* Add ellipsis for overflowing text */\n    word-wrap: break-word; /* Break long words */\n    max-height: 40px; /* Adjust max height to fit within the tile */\n    display: -webkit-box; /* Support for multiline ellipsis */\n    -webkit-line-clamp: 2; /* Number of lines to show */\n    -webkit-box-orient: vertical; /* Vertical orientation */\n    line-height: 1.2; /* Adjust line height for better text spacing */\n    text-align: center; /* Center align text */\n}\n\n/* Mobile version: increase the width of the tiles */\n@media (max-width: 768px) {\n    .comm-tile-menu__item {\n        width: 80%; /* Increase width to 100% for mobile view */\n    }\n}",
